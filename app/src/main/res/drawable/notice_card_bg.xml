<?xml version="1.0" encoding="utf-8"?>
<!-- v6.3 — the "اعلان Professor Vpn" announcement card.
     Theme-aware: the fill/stroke come from theme attributes so the card is
     legible in BOTH the dark and the light theme (v6.3 light-theme fix). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/appCardColor" />
    <corners android:radius="14dp" />
    <stroke android:width="1dp" android:color="?attr/appStroke" />
</shape>
