<?xml version="1.0" encoding="utf-8"?>
<!-- Server row card. v6.3 — theme-aware surfaces; violet rim when selected. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="?attr/appCardActiveColor" />
            <stroke android:width="1.4dp" android:color="?attr/appAccentGreen" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="?attr/appCardColor" />
            <stroke android:width="1dp" android:color="?attr/appHairline" />
        </shape>
    </item>
</selector>
