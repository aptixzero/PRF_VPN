<?xml version="1.0" encoding="utf-8"?>
<!--
  v6.4 — background of the Home country-flag tile.

  The flag itself now fills the tile exactly (FlagView paints edge-to-edge), so
  this shape's job is only to (a) give the tile its rounded-square silhouette and
  (b) show a subtle empty state before we are connected. The corner radius is
  what visually clips the flag into a neat square.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="9dp" />
    <solid android:color="?attr/appTagFill" />
    <stroke android:width="1dp" android:color="?attr/appTagStroke" />
</shape>
