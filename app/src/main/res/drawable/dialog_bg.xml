<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog surface. v6.3 — theme-aware: near-black in dark, white in light,
     both with a soft violet rim. Fixes unreadable dialogs in light theme. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="20dp" />
    <solid android:color="?attr/appPanelColor" />
    <stroke android:width="1dp" android:color="#55A855F7" />
</shape>
