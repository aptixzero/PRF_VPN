<?xml version="1.0" encoding="utf-8"?>
<!-- =====================================================================
     v6.3 — "Download Links" page (hamburger menu → Download Links).

     Top    : a QR/bar code. A nearby person points their camera at it; the
              code carries a deep link that makes THEIR phone turn its own
              Bluetooth on and prepares to receive the APK.
     Middle : the "Send app over Bluetooth" button + the reminder that the
              other device's Bluetooth must be ON as well.
     Bottom : the admin-published download links, in a SCROLLABLE list, each
              row with a COPY button so the user can paste it in a browser.

     Every colour is a theme attribute, so this page is correct in BOTH the
     dark and the light theme.
     ===================================================================== -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBgDrawable">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ===== top bar ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/appPanelColor"
            android:paddingHorizontal="10dp">

            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:src="@drawable/ic_back"
                app:tint="?attr/appTextPrimary"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/close" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/downloads_title"
                android:textColor="?attr/appTextPrimary"
                android:textSize="17sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <!-- ===== scrollable body ===== -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/dl_heading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/downloads_heading"
                    android:textColor="?attr/appTextPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/dl_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/downloads_note"
                    android:textColor="?attr/appTextSecondary"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginTop="6dp" />

                <!-- ===== QR card ===== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:background="@drawable/notice_card_bg"
                    android:padding="18dp"
                    android:layout_marginTop="14dp">

                    <ImageView
                        android:id="@+id/qr_image"
                        android:layout_width="230dp"
                        android:layout_height="230dp"
                        android:background="#FFFFFFFF"
                        android:padding="6dp"
                        android:contentDescription="@string/downloads_qr_hint" />

                    <TextView
                        android:id="@+id/qr_hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/downloads_qr_hint"
                        android:textColor="?attr/appTextDim"
                        android:textSize="11sp"
                        android:layout_marginTop="10dp" />

                    <TextView
                        android:id="@+id/bt_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/downloads_bt_prompt"
                        android:textColor="?attr/appAccentGreen"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginTop="6dp" />

                    <LinearLayout
                        android:id="@+id/btn_bluetooth"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/btn_cta_telegram"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_bluetooth"
                            app:tint="#FFFFFFFF"
                            android:layout_marginEnd="8dp"
                            android:contentDescription="@string/downloads_share_bt" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/downloads_share_bt"
                            android:textColor="#FFFFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ===== download links ===== -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/downloads_links_header"
                    android:textColor="?attr/appTextPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/dl_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/downloads_empty"
                    android:textColor="?attr/appTextDim"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <!-- The links are a SCROLLABLE list: this RecyclerView has
                     unbounded height inside the ScrollView (nestedScrolling
                     disabled) so the whole page scrolls as one, no matter how
                     many links the panel publishes. -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/dl_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
