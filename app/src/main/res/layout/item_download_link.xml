<?xml version="1.0" encoding="utf-8"?>
<!-- v6.3 — one row of the Download Links list: title + url + COPY button.
     COPY puts the raw url on the clipboard so the user can paste it into a
     browser (exactly what the brief asked for). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/notice_card_bg"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/dl_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/appTextPrimary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/dl_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/appTextSecondary"
            android:textSize="11sp"
            android:maxLines="2"
            android:ellipsize="middle"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/dl_item_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/appTextDim"
            android:textSize="10sp"
            android:visibility="gone"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/dl_open"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:padding="8dp"
        android:layout_marginStart="6dp"
        android:src="@drawable/ic_download"
        app:tint="?attr/appTextSecondary"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/downloads_open" />

    <TextView
        android:id="@+id/dl_copy"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:gravity="center"
        android:minWidth="64dp"
        android:paddingHorizontal="12dp"
        android:text="@string/downloads_copy"
        android:textColor="#FFFFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginStart="4dp"
        android:background="@drawable/btn_cta_telegram"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground" />
</LinearLayout>
